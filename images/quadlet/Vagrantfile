Vagrant.configure("2") do |config|
  config.vm.box = "bento/fedora-40"
  config.vm.hostname = "pulp-quadlet-test"

  # Pulp web UI / API accessible on the host
  config.vm.network "forwarded_port", guest: 8080, host: 8080

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
  end

  config.vm.provider "libvirt" do |lv|
    lv.memory = 4096
    lv.cpus = 2
  end

  # Sync only the quadlet directory into the VM (excludes .git, etc.)
  config.vm.synced_folder ".", "/vagrant/quadlet", type: "rsync",
    rsync__exclude: ["Vagrantfile", "provision.sh", ".vagrant/"]

  # Re-sync quadlet files before every provision run so file layout changes are picked up.
  config.trigger.before :provision do |trigger|
    trigger.run = { inline: "vagrant rsync" }
  end

  config.vm.provision "shell", path: "provision.sh"
end
