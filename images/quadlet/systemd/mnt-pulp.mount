[Unit]
Description=Mount Pulp NFS storage
After=network-online.target
Wants=network-online.target

[Mount]
# Replace <NFS_SERVER_IP> with your NFS server address
What=<NFS_SERVER_IP>:/pulp
Where=/mnt/pulp
Type=nfs4
Options=vers=4.2,_netdev,rw,hard,timeo=600,retrans=3,context=system_u:object_r:container_file_t:s0

[Install]
WantedBy=remote-fs.target
