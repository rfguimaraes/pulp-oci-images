[Unit]
Description=Pulp Content (%i)
PartOf=pulp-contents.target
BindsTo=pulp-contents.target
After=pulp-set-init-password.service
Requires=pulp-set-init-password.service

[Service]
Restart=on-failure
RestartSec=60s
CPUQuota=150%
MemoryHigh=1G
MemoryMax=1500M
MemorySwapMax=500M

[Container]
Image=quay.io/pulp/pulp-minimal:latest
Exec=pulp-content
User=700
HostName=pulp-content-%i
LogDriver=journald
LogOpt=tag={{.Name}}
UserNS=keep-id:uid=700,gid=700
Network=pulpnet.network:alias=pulp_content
Environment=PULP_GUNICORN_TIMEOUT=90

# Healthcheck
HealthCmd=readyz.py /pulp/content
HealthInterval=10s
HealthRetries=5
HealthTimeout=5s

# Volumes
Volume=/home/pulp/pulp/assets/settings.py:/etc/pulp/settings.py:z
Volume=/home/pulp/pulp/assets/certs:/etc/pulp/certs:z
Volume=pulp.volume:/var/lib/pulp

[Install]
WantedBy=pulp-contents.target
